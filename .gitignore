__pycache__/
*.py[cod]
.DS_Store
.venv/
build/
node_modules/

# Provider credentials. The harness reads model keys from the environment
# (GEMINI_API_KEY, OPENAI_API_KEY, OPENCLAW_PROVIDER_API_KEY, ...), so a .env
# next to the checkout is the obvious place to keep them and must never be
# committable. .env.example is the one file worth tracking.
.env
.env.*
!.env.example

# Build and tooling artifacts. build/ was already covered; dist/ is what
# `python -m build` actually writes.
/dist/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
/venv/

# Editor state
.idea/
.vscode/
/runs/
/images/
/login-state/
/logs/
*.egg-info/
/dataset_dev/

# Mock service runtime artifacts (SQLite DBs, Bun lockfiles auto-generated on first run)
real_replica_bench/mock_services/*/data/
!real_replica_bench/mock_services/google_docs_mock/data/
!real_replica_bench/mock_services/google_docs_mock/data/seed_state.json
# ** so these reach staged services under contrib/<name>/ too, not just the
# shipped services one level down.
real_replica_bench/mock_services/**/bun.lock
real_replica_bench/mock_services/**/node_modules/

# Claude Code local session / hooks dir
.claude/

# Agent guidance files. These describe how we work on the benchmark rather than
# how to use it, and they go stale faster than the release does. Contributors
# get their instructions from CONTRIBUTING.md instead.
/CLAUDE.md
/CLAUDE.local.md

# Hosted-site workspaces and the legacy in-repo web pages. The public pages are
# deployed from local site workspaces — rrb-report/ builds the leaderboard at
# realreplicabench.site.accio.ai — and are NOT shipped in this repository.
# rrb-matrix/ builds a site this release does not link; it stays local too.
# The legacy docs/index.html and docs/matrix.html pages (plus their page-only
# assets and data-regeneration helper) stay local for site maintenance. Runtime
# docs and README assets under
# docs/ remain tracked. A new site workspace needs its own line here — nothing
# below is a glob, so an unlisted one shows up untracked and is one `git add -A`
# away from landing in the repository.
/rrb-report/
/rrb-report-v2/
/rrb-matrix/
/project/
/docs/index.html
/docs/matrix.html
/docs/assets/model-icons/
/docs/screenshots/
/scripts/build_site_data.py

# Site-QA scratch (viewport screenshots, overflow probes, in-page DOM rect
# measurements) from the same site work
/reports/
/screenshots/
/shots/
/overflow_page*.json
/hero_measure*.js
/hero_measure*.json

# Session-scoped scratch space — one-off orchestrators, per-campaign yaml bundles,
# in-progress release HTML drafts. README is the only tracked file; see scratch/README.md
# for the convention. New campaign scripts/configs/docs go under scratch/{scripts,configs,docs}/
# and inherit this ignore — no need to add per-file lines here.
# Pattern: ignore *contents* of scratch/ (not the dir itself), then re-include README.
# (Ignoring the dir itself would prevent the README negation from taking effect.)
/scratch/*
!/scratch/README.md

# Reference results. The live leaderboard at realreplicabench.site.accio.ai is
# the source of record; a JSON snapshot in the repo only ever drifts behind it
# and gives readers two numbers to choose between. README carries a
# human-readable snapshot and says the site wins.
/results/

# Internal scoring-change forensics. The fix list documents exactly what each
# grader checks and how it was tightened — a contamination route to publish for
# a benchmark. Keep the record local; the public docs state only that scores
# are comparable within one benchmark version.
/docs/task-hardening-2026-08.md

# Internal benchmark strategy and positioning notes. These working documents
# may contain pre-release reasoning and success criteria that are not public
# commitments; keep the whole directory, including its local figures, out of
# the release repository.
/docs/internal/

# Internal image-overlay recipes. The published runtime is distributed as an
# immutable digest (docs/openclaw-runtime-image.md); the intermediate build
# lanes that produced it are internal R&D records, not part of the release.
/docker/patches/

# Chinese-language authoring and developer notes. The release documents itself
# in English; these were written for internal contributors and never got a
# translation pass, so they read as unfinished to a public reader. They stay on
# disk for local use.
#
# Scope is deliberately narrow: authoring notes ONLY. Chinese inside
# datasets_domain_v1/ task content (task.md and the workspace fixtures beside
# it) and inside mock-service UI/seed data is benchmark material that the agent
# is meant to read — several tasks declare language = "zh-CN" in task.toml.
# Ignoring any of that would break the tasks it belongs to. Do not widen this
# list to "every tracked file containing Chinese".
/datasets_domain_v1/README.md
/real_replica_bench/mock_services/gmail_mock/README.md
/real_replica_bench/mock_services/google_docs_mock/README.md
/real_replica_bench/mock_services/notion_cli/test/README.md
/real_replica_bench/mock_services/shopify_online_store_v2/README.md
/real_replica_bench/mock_services/stripe_cli/README.md
/real_replica_bench/mock_services/stripe_cli/TUTORIAL.md
/real_replica_bench/mock_services/stripe_cli/golden/README.md
