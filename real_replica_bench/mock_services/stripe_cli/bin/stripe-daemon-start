#!/usr/bin/env bash
set -euo pipefail
: "${CCB_MOCK_SERVICES_ROOT:=/opt/mock_services}"

WORKDIR=""
PRIVATE_DIR=""
PORT="${PORT:-3000}"
TOKEN="${MOCK_VERIFIER_TOKEN:-bench-verifier}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workdir)
      WORKDIR="$2"; shift 2 ;;
    --private-dir)
      PRIVATE_DIR="$2"; shift 2 ;;
    --port)
      PORT="$2"; shift 2 ;;
    --token)
      TOKEN="$2"; shift 2 ;;
    *)
      echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STATE_DIR="${STRIPE_MOCK_STATE_DIR:-/var/lib/mocksvc/stripe_cli}"
STRIPE_BENCH="$SERVICE_ROOT/bin/stripe-bench"
HEALTH_URL="http://127.0.0.1:${PORT}/health"
SEED_FILE="${PRIVATE_DIR%/}/mock_runtime/stripe_seed.json"

export STRIPE_MOCK_DB="${STRIPE_MOCK_DB:-$STATE_DIR/stripe_mock.sqlite}"
export STRIPE_API_KEY="${STRIPE_API_KEY:-sk_test_mock_benchmark_key}"
export MOCK_VERIFIER_TOKEN="$TOKEN"
export CCB_INTERNAL_BENCH_TOKEN="$TOKEN"
export PORT="$PORT"

mkdir -p "$STATE_DIR" "$WORKDIR/tmp"
chmod 0700 "$STATE_DIR" "$WORKDIR" 2>/dev/null || true
LOG_FILE="$WORKDIR/tmp/stripe_cli_daemon.log"
PID_FILE="$WORKDIR/tmp/stripe_cli_daemon.pid"

[[ -x "$STRIPE_BENCH" ]] || { echo "stripe-bench missing at $STRIPE_BENCH" >&2; exit 2; }
[[ -f "$CCB_MOCK_SERVICES_ROOT/cli_daemon/server.mjs" ]] || { echo "cli daemon missing at $CCB_MOCK_SERVICES_ROOT/cli_daemon/server.mjs" >&2; exit 2; }
command -v bun >/dev/null 2>&1 || { echo "bun not found in container" >&2; exit 2; }

rm -f "$STRIPE_MOCK_DB" "$STRIPE_MOCK_DB-wal" "$STRIPE_MOCK_DB-shm"
"$STRIPE_BENCH" reset >/dev/null 2>&1 || true
if [[ -n "$PRIVATE_DIR" && -f "$SEED_FILE" ]]; then
  "$STRIPE_BENCH" seed --file "$SEED_FILE" >/dev/null
else
  "$STRIPE_BENCH" seed >/dev/null
fi

probe() {
  python3 - "$1" <<'PY' >/dev/null 2>&1
import sys, urllib.request
urllib.request.urlopen(sys.argv[1], timeout=2).read()
PY
}

export CCB_CLI_MOCK_NAME="stripe_cli"
export CCB_CLI_TARGET_BIN="$SERVICE_ROOT/bin/stripe"
export CCB_CLI_BENCH_BIN="$STRIPE_BENCH"
export CCB_CLI_BENCH_TOKEN_MODE="env"
export CCB_CLI_STATE_ENV_JSON="{\"STRIPE_MOCK_DB\":\"$STRIPE_MOCK_DB\",\"STRIPE_API_KEY\":\"$STRIPE_API_KEY\"}"

nohup bun $CCB_MOCK_SERVICES_ROOT/cli_daemon/server.mjs >"$LOG_FILE" 2>&1 &
echo "$!" > "$PID_FILE"

ready=0
for _ in $(seq 1 60); do
  if probe "$HEALTH_URL"; then ready=1; break; fi
  sleep 0.5
done
if [[ "$ready" != "1" ]]; then
  echo "stripe_cli daemon failed; tail of $LOG_FILE:" >&2
  tail -n 80 "$LOG_FILE" >&2 || true
  exit 1
fi

echo "stripe_cli daemon ready on :$PORT"
