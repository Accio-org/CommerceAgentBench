{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "api-slack-contacts-sourcing-project-status-brief answer",
  "type": "object",
  "required": [
    "overall_health_status",
    "coo_current_slack_handle",
    "coo_stale_slack_handle",
    "valid_sample_id",
    "invalid_sample_id",
    "new_supplier_unit_price_usd",
    "new_supplier_moq_units",
    "margin_normal_pct",
    "margin_with_airfreight_pct",
    "margin_red_line_pct",
    "airfreight_surcharge_usd",
    "supplier_first_batch_capacity_units",
    "supplier_first_batch_etd_iso",
    "compliance_rohs_status",
    "compliance_reach_status",
    "reach_2026_report_deadline_iso",
    "qa_replacement_name",
    "qa_replacement_arrive_iso",
    "qa_replacement_travel_decision_deadline_time"
  ],
  "additionalProperties": false,
  "properties": {
    "overall_health_status": { "type": "string", "enum": ["green", "yellow", "amber", "red"] },
    "coo_current_slack_handle": { "type": "string", "pattern": "^@" },
    "coo_stale_slack_handle": { "type": "string", "pattern": "^@" },
    "valid_sample_id": { "type": "string", "minLength": 1 },
    "invalid_sample_id": { "type": "string", "minLength": 1 },
    "new_supplier_unit_price_usd": { "type": "number" },
    "new_supplier_moq_units": { "type": "integer" },
    "margin_normal_pct": { "type": "number" },
    "margin_with_airfreight_pct": { "type": "number" },
    "margin_red_line_pct": { "type": "number" },
    "airfreight_surcharge_usd": { "type": "number" },
    "supplier_first_batch_capacity_units": { "type": "integer" },
    "supplier_first_batch_etd_iso": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "compliance_rohs_status": { "type": "string", "enum": ["ok", "pending", "not_required"] },
    "compliance_reach_status": { "type": "string", "enum": ["ok", "pending", "not_required"] },
    "reach_2026_report_deadline_iso": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "qa_replacement_name": { "type": "string", "minLength": 1 },
    "qa_replacement_arrive_iso": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "qa_replacement_travel_decision_deadline_time": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" }
  }
}
