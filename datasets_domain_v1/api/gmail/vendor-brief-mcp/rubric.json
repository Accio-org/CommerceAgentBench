      "description": "True blockers were starred and decoys were not."
    },
    {
      "id": "drafts_correct",
      "check_type": "deterministic_semantic",
      "description": "The required unsent Buyer Ops brief draft is composed with the expected vendor facts."
    },
    {
      "id": "calendar_event_correct",
      "check_type": "deterministic_semantic",
      "description": "The supplier-call calendar event is scheduled at the requested time with the required guests and vendor facts."
    },
    {
      "id": "no_messages_sent",
      "check_type": "deterministic_exact",
      "description": "Negative restraint: no email was actually sent."
    }
