              "packing_list",
              "bill_of_lading",
              "certificate_of_origin",
              "insurance_policy",
              "bank_presentation_schedule",
              "cover_letter"
            ]
          },
          "field": {"type": "string"},
          "lc_says": {"type": "string"},
          "doc_says": {"type": "string"},
          "rule_cite": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "non_material_examined": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc", "field", "rule_cite"],
        "properties": {
          "id": {"type": "string"},
          "doc": {"type": "string"},
          "field": {"type": "string"},
          "lc_says": {"type": "string"},
          "doc_says": {"type": "string"},
          "rule_cite": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
