#!/usr/bin/env bun
// todoist-bench — bench control binary for verifier access
// Provides: state, seed, reset, health, audit

import { openDb, dbPath } from '../lib/db.js';
import { existsSync, readFileSync } from 'node:fs';
import { writeSync as __ccbWriteSyncFd } from "node:fs";
// Flush-safe stdout: process.exit() discards un-flushed async pipe writes
// (verifier state JSON >64KB was truncated through the daemon). writeSync
// to fd 1 is synchronous in both node and bun.
const __ccbOut = (s) => { try { __ccbWriteSyncFd(1, s); } catch (e) {} };

// Verifier-only secret. Mirrors bench_core/mock_services/jira_cli/
// bin/jira-bench: every authenticated bench command must present this exact
// token. `health` stays unauthenticated. Override with MOCK_VERIFIER_TOKEN.
const VERIFIER_TOKEN = process.env.MOCK_VERIFIER_TOKEN || "bench-verifier";

const args = process.argv.slice(2);
const command = args[0];

function usage() {
  __ccbOut(`Usage: todoist-bench <command> [options]

Commands:
  state   --token <T>            Dump full DB state as JSON
  seed    --token <T> --file <f> Run SQL file against DB
  reset   --token <T>            Wipe and re-seed DB
  health                         Check DB exists and is readable
  audit   --token <T>            Dump audit log as JSON
`);
}

function parseFlags(a) {
  const flags = {};
  for (let i = 0; i < a.length; i++) {
    if (a[i] === '--token' && i + 1 < a.length) { flags.token = a[++i]; continue; }
    if (a[i] === '--file' && i + 1 < a.length) { flags.file = a[++i]; continue; }
  }
  return flags;
}

function requireToken(flags) {
  if (flags.token !== VERIFIER_TOKEN && process.env.CCB_INTERNAL_BENCH_TOKEN !== VERIFIER_TOKEN) {
    process.stderr.write('Error: invalid or missing verifier token\n');
    process.exit(1);
  }
}

switch (command) {
  case 'health': {
    const p = dbPath();
    if (existsSync(p)) {
      try {
        const db = openDb(p);
        const count = db.query('SELECT COUNT(*) as c FROM items').get();
        db.close();
        __ccbOut(JSON.stringify({ status: 'ok', db_path: p, items: count.c }) + '\n');
        process.exit(0);
      } catch (e) {
        __ccbOut(JSON.stringify({ status: 'error', error: e.message }) + '\n');
        process.exit(1);
      }
    } else {
      // DB doesn't exist yet — that's fine, it'll be created on first use
      __ccbOut(JSON.stringify({ status: 'ok', db_path: p, items: 0, note: 'db not yet created' }) + '\n');
      process.exit(0);
    }
  }

  case 'state': {
    const flags = parseFlags(args.slice(1));
    requireToken(flags);
    const db = openDb();

    const state = {
      projects: db.prepare('SELECT * FROM projects ORDER BY item_order').all(),
      labels: db.prepare('SELECT * FROM labels ORDER BY item_order').all(),
      sections: db.prepare('SELECT * FROM sections ORDER BY section_order').all(),
      filters: db.prepare('SELECT * FROM filters ORDER BY item_order').all(),
      items: db.prepare('SELECT * FROM items ORDER BY item_order').all(),
      auth: db.prepare('SELECT * FROM auth_session').all(),
    };

    // Parse labels_json for each item
    for (const item of state.items) {
      try { item.labels = JSON.parse(item.labels_json); } catch { item.labels = []; }
    }

    db.close();
    __ccbOut(JSON.stringify(state, null, 2) + '\n');
    process.exit(0);
  }

  case 'audit': {
    const flags = parseFlags(args.slice(1));
    requireToken(flags);
    const db = openDb();

    const logs = db.prepare('SELECT * FROM audit_log ORDER BY id ASC').all();
    for (const log of logs) {
      try { log.details = JSON.parse(log.details_json); } catch { log.details = {}; }
    }

    db.close();
    __ccbOut(JSON.stringify(logs, null, 2) + '\n');
    process.exit(0);
  }

  case 'seed': {
    const flags = parseFlags(args.slice(1));
    requireToken(flags);
    if (!flags.file) {
      process.stderr.write('Error: --file is required\n');
      process.exit(1);
    }
    if (!existsSync(flags.file)) {
      process.stderr.write(`Error: file not found: ${flags.file}\n`);
      process.exit(1);
    }

    const db = openDb();
    const sql = readFileSync(flags.file, 'utf-8');
    db.exec(sql);
    db.close();
    __ccbOut('Seed applied successfully\n');
    process.exit(0);
  }

  case 'reset': {
    const flags = parseFlags(args.slice(1));
    requireToken(flags);
    const db = openDb();

    // Drop all data
    db.exec('DELETE FROM audit_log');
    db.exec('DELETE FROM items');
    db.exec('DELETE FROM sections');
    db.exec('DELETE FROM labels');
    db.exec('DELETE FROM projects');
    db.exec('DELETE FROM auth_session');

    // Re-seed with defaults
    const { join, dirname } = await import('node:path');
    const mockDir = dirname(dirname(import.meta.path));
    const seedPath = join(mockDir, 'seeds', 'default.sql');
    if (existsSync(seedPath)) {
      const seedSql = readFileSync(seedPath, 'utf-8');
      db.exec(seedSql);
    }

    db.close();
    __ccbOut('Database reset to defaults\n');
    process.exit(0);
  }

  default:
    usage();
    process.exit(command ? 1 : 0);
}
