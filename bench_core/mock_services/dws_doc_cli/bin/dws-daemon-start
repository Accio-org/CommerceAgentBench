#!/usr/bin/env bash
set -euo pipefail
: "${CCB_MOCK_SERVICES_ROOT:=/opt/mock_services}"

WORKDIR=""
PRIVATE_DIR=""
PORT="${PORT:-3020}"
TOKEN="${MOCK_VERIFIER_TOKEN:-bench-verifier}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workdir)
      WORKDIR="$2"; shift 2 ;;
    --private-dir)
      PRIVATE_DIR="$2"; shift 2 ;;
    --port)
      PORT="$2"; shift 2 ;;
    --token)
      TOKEN="$2"; shift 2 ;;
    *)
      echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STATE_DIR="${DWS_MOCK_STATE_DIR:-/var/lib/mocksvc/dws_doc_cli}"
DWS_BENCH="$SERVICE_ROOT/bin/dws-bench"
HEALTH_URL="http://127.0.0.1:${PORT}/health"
TASK_SEED_FILE="${PRIVATE_DIR%/}/mock_runtime/dws_seed.sql"

export DWS_MOCK_HOME="$STATE_DIR"
export MOCK_VERIFIER_TOKEN="$TOKEN"
export CCB_INTERNAL_BENCH_TOKEN="$TOKEN"
export PORT="$PORT"

mkdir -p "$STATE_DIR" "$WORKDIR/tmp"
chmod 0700 "$STATE_DIR" "$WORKDIR" 2>/dev/null || true
LOG_FILE="$WORKDIR/tmp/dws_doc_cli_daemon.log"
PID_FILE="$WORKDIR/tmp/dws_doc_cli_daemon.pid"

[[ -x "$SERVICE_ROOT/bin/dws" ]] || { echo "dws client missing at $SERVICE_ROOT/bin/dws" >&2; exit 2; }
[[ -x "$DWS_BENCH" ]] || { echo "dws-bench missing at $DWS_BENCH" >&2; exit 2; }
[[ -f "$CCB_MOCK_SERVICES_ROOT/cli_daemon/server.mjs" ]] || { echo "cli daemon missing at $CCB_MOCK_SERVICES_ROOT/cli_daemon/server.mjs" >&2; exit 2; }
command -v bun >/dev/null 2>&1 || { echo "bun not found in container" >&2; exit 2; }

rm -f "$DWS_MOCK_HOME/mock.db" "$DWS_MOCK_HOME/mock.db-wal" "$DWS_MOCK_HOME/mock.db-shm"
"$DWS_BENCH" reset >/dev/null
if [[ -n "$PRIVATE_DIR" && -f "$TASK_SEED_FILE" ]]; then
  "$DWS_BENCH" seed-sql --file "$TASK_SEED_FILE" >/dev/null
  echo "dws_doc_cli seeded from $TASK_SEED_FILE"
fi

probe() {
  python3 - "$1" <<'PY' >/dev/null 2>&1
import sys, urllib.request
urllib.request.urlopen(sys.argv[1], timeout=2).read()
PY
}

export CCB_CLI_MOCK_NAME="dws_doc_cli"
export CCB_CLI_TARGET_BIN="$SERVICE_ROOT/bin/dws"
export CCB_CLI_BENCH_BIN="$DWS_BENCH"
export CCB_CLI_BENCH_TOKEN_MODE="env"
export CCB_CLI_STATE_ENV_JSON="{\"DWS_MOCK_HOME\":\"$DWS_MOCK_HOME\"}"
export CCB_CLI_BENCH_PATHS_JSON='{"/__bench/state":"state","/__bench/audit":"audit","/api/state":"state","/api/audit":"audit"}'

nohup bun $CCB_MOCK_SERVICES_ROOT/cli_daemon/server.mjs >"$LOG_FILE" 2>&1 &
echo "$!" > "$PID_FILE"

ready=0
for _ in $(seq 1 60); do
  if probe "$HEALTH_URL"; then ready=1; break; fi
  sleep 0.5
done
if [[ "$ready" != "1" ]]; then
  echo "dws_doc_cli daemon failed; tail of $LOG_FILE:" >&2
  tail -n 80 "$LOG_FILE" >&2 || true
  exit 1
fi

echo "dws_doc_cli daemon ready on :$PORT"
