#!/usr/bin/env bun
/**
 * bin/stripe — Stripe CLI mock 入口。Shadows stripe/stripe-cli v1.42.1。
 * 全部状态走 bun:sqlite，无网络调用。
 */
import { dispatch } from "../lib/dispatch.js";

try {
  dispatch(process.argv.slice(2));
} catch (err) {
  process.stderr.write(`Error: ${err.message}\n`);
  process.exit(1);
}
