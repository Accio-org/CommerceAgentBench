#!/usr/bin/env bash
set -euo pipefail
: "${CCB_MOCK_SERVICES_ROOT:=/opt/mock_services}"

WORKDIR=""
PRIVATE_DIR=""
PORT="${PORT:-3456}"
TOKEN="${MOCK_VERIFIER_TOKEN:-bench-verifier}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workdir)
      WORKDIR="$2"; shift 2 ;;
    --private-dir)
      PRIVATE_DIR="$2"; shift 2 ;;
    --port)
      PORT="$2"; shift 2 ;;
    --token)
      TOKEN="$2"; shift 2 ;;
    *)
      echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STATE_DIR="${NTN_MOCK_STATE_DIR:-/var/lib/mocksvc/notion_cli}"
BACKEND_PORT="${NTN_MOCK_BACKEND_PORT:-$((PORT + 1))}"
NTN_CLIENT="$SERVICE_ROOT/bin/ntn"
NTN_BENCH="$SERVICE_ROOT/bin/ntn-mock-bench"
HEALTH_URL="http://127.0.0.1:${PORT}/health"
BACKEND_HEALTH_URL="http://127.0.0.1:${BACKEND_PORT}/health"
TASK_SEED_FILE="${PRIVATE_DIR%/}/seed_overlay.json"
ALT_TASK_SEED_FILE="${PRIVATE_DIR%/}/mock_runtime/seed_overlay.json"

export NTN_MOCK_DATA_DIR="$STATE_DIR"
export NTN_MOCK_NO_AUTO_SERVER="${NTN_MOCK_NO_AUTO_SERVER:-1}"
export NTN_MOCK_SEED_PROFILE="${NTN_MOCK_SEED_PROFILE:-commerce}"
export MOCK_VERIFIER_TOKEN="$TOKEN"
export CCB_INTERNAL_BENCH_TOKEN="$TOKEN"

mkdir -p "$STATE_DIR" "$WORKDIR/tmp"
chmod 0700 "$STATE_DIR" "$WORKDIR" 2>/dev/null || true
BACKEND_LOG_FILE="$WORKDIR/tmp/notion_cli_backend.log"
DAEMON_LOG_FILE="$WORKDIR/tmp/notion_cli_daemon.log"
PID_FILE="$WORKDIR/tmp/notion_cli_daemon.pid"

[[ -x "$NTN_CLIENT" ]] || { echo "ntn client missing at $NTN_CLIENT" >&2; exit 2; }
[[ -x "$NTN_BENCH" ]] || { echo "ntn-mock-bench missing at $NTN_BENCH" >&2; exit 2; }
[[ -f "$CCB_MOCK_SERVICES_ROOT/cli_daemon/server.mjs" ]] || { echo "cli daemon missing at $CCB_MOCK_SERVICES_ROOT/cli_daemon/server.mjs" >&2; exit 2; }
command -v bun >/dev/null 2>&1 || { echo "bun not found in container" >&2; exit 2; }

rm -f "$NTN_MOCK_DATA_DIR/mock.db" "$NTN_MOCK_DATA_DIR/mock.db-wal" "$NTN_MOCK_DATA_DIR/mock.db-shm"

probe() {
  python3 - "$1" <<'PY' >/dev/null 2>&1
import sys, urllib.request
urllib.request.urlopen(sys.argv[1], timeout=2).read()
PY
}

NTN_MOCK_PORT="$BACKEND_PORT" nohup bun "$SERVICE_ROOT/lib/server/index.js" >"$BACKEND_LOG_FILE" 2>&1 &
echo "$!" > "$PID_FILE"

backend_ready=0
for _ in $(seq 1 60); do
  if probe "$BACKEND_HEALTH_URL"; then backend_ready=1; break; fi
  sleep 0.5
done
if [[ "$backend_ready" != "1" ]]; then
  echo "notion_cli backend failed; tail of $BACKEND_LOG_FILE:" >&2
  tail -n 80 "$BACKEND_LOG_FILE" >&2 || true
  exit 1
fi

NTN_MOCK_PORT="$BACKEND_PORT" "$NTN_BENCH" reset --token "$TOKEN" >/dev/null
if [[ -n "$PRIVATE_DIR" && -f "$TASK_SEED_FILE" ]]; then
  NTN_MOCK_PORT="$BACKEND_PORT" "$NTN_BENCH" seed --token "$TOKEN" --file "$TASK_SEED_FILE" >/dev/null
  echo "notion_cli seeded from $TASK_SEED_FILE"
elif [[ -n "$PRIVATE_DIR" && -f "$ALT_TASK_SEED_FILE" ]]; then
  NTN_MOCK_PORT="$BACKEND_PORT" "$NTN_BENCH" seed --token "$TOKEN" --file "$ALT_TASK_SEED_FILE" >/dev/null
  echo "notion_cli seeded from $ALT_TASK_SEED_FILE"
fi

export PORT="$PORT"
export CCB_CLI_MOCK_NAME="notion_cli"
export CCB_CLI_TARGET_BIN="$NTN_CLIENT"
export CCB_CLI_BENCH_BIN="$NTN_BENCH"
export CCB_CLI_BENCH_TOKEN_MODE="env"
export CCB_CLI_STATE_ENV_JSON="{\"NTN_MOCK_DATA_DIR\":\"$NTN_MOCK_DATA_DIR\",\"NTN_MOCK_PORT\":\"$BACKEND_PORT\",\"NTN_MOCK_NO_AUTO_SERVER\":\"$NTN_MOCK_NO_AUTO_SERVER\",\"NTN_MOCK_SEED_PROFILE\":\"$NTN_MOCK_SEED_PROFILE\"}"
export CCB_CLI_BENCH_PATHS_JSON='{"/__bench/state":"state","/__bench/audit":"audit"}'
export CCB_CLI_HTTP_PROXY_BASE_URL="http://127.0.0.1:${BACKEND_PORT}"
export CCB_CLI_HTTP_PROXY_PREFIXES_JSON='["/api/state","/api/files/"]'

nohup bun $CCB_MOCK_SERVICES_ROOT/cli_daemon/server.mjs >"$DAEMON_LOG_FILE" 2>&1 &
echo "$!" >> "$PID_FILE"

ready=0
for _ in $(seq 1 60); do
  if probe "$HEALTH_URL"; then ready=1; break; fi
  sleep 0.5
done
if [[ "$ready" != "1" ]]; then
  echo "notion_cli daemon failed; tail of $DAEMON_LOG_FILE:" >&2
  tail -n 80 "$DAEMON_LOG_FILE" >&2 || true
  exit 1
fi

echo "notion_cli daemon ready on :$PORT (backend :$BACKEND_PORT)"
